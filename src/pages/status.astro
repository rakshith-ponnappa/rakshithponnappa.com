---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { getStatus, slots, describeEntry, entryState, pct, STATE_LABEL, STATE_TONE, HIT3_MIN, REFUSAL_MIN, type Group, type Slot } from '../lib/status';

const s = await getStatus();
const groups: { id: Group; title: string; note: string }[] = [
  { id: 'build', title: 'Build', note: 'computed when this page was built' },
  { id: 'edge', title: 'Edge', note: 'checked live from your browser' },
  { id: 'gate', title: 'Quality gates', note: 'read from the QA suite report' },
];
const stamp = (iso: string) => iso.slice(0, 16).replace('T', ' ') + ' UTC';
const repo = `${profile.github}/rakshith-ponnappa.github.io`;
const passing = s.history.filter((e) => entryState(e) === 'ok').length;
const latest = s.history[s.history.length - 1];
const corpusVersion = s.components.find((c) => c.id === 'corpus')?.evidence.match(/version (\w+)/)?.[1] ?? '';

// One strip per breakpoint: 90 slots on wide screens, the last 30 on phones (bars stay legible).
const W = 6;
const GAP = 2;
const H = 34;
const strips = [
  { n: 90, cls: 'wide', list: slots(s.history, 90, s.sha) },
  { n: 30, cls: 'narrow', list: slots(s.history, 30, s.sha) },
];
const label = (sl: Slot) => (sl.entry ? `${describeEntry(sl.entry)}${sl.current ? ' · this build' : ''}` : 'No data: no deploy recorded in this slot');
const okShare = s.history.length ? pct(passing / s.history.length) : '–';
---

<BaseLayout
  title="Status"
  description="A status page computed from build data: retrieval evals, corpus, content, résumé PDF and live edge checks, with per-deploy history."
>
  <section class="container-x page-head">
    <p class="eyebrow">Status · computed, not declared</p>
    <h1>System <em class="serif">status.</em></h1>
    <p class="lede">
      Every state on this page comes from the build that produced it or from a live check your browser runs. Nothing here is hard-coded,
      so when something degrades, this page says so.
    </p>
  </section>

  <div class="container-x stack" data-status-page data-corpus-version={corpusVersion}>
    <section class="banner" data-state={s.overall.status} aria-labelledby="overall">
      <span class="dot big" data-tone={STATE_TONE[s.overall.status]} data-overall-dot></span>
      <div class="banner-copy">
        <h2 id="overall" data-overall-headline>{s.overall.headline}</h2>
        <p class="mono summary">
          <span>{s.overall.operational}/{s.overall.measured} build checks operational</span>
          {s.overall.degraded > 0 && <span>{s.overall.degraded} degraded</span>}
          {s.overall.down > 0 && <span>{s.overall.down} down</span>}
          {s.overall.notMeasured > 0 && <span>{s.overall.notMeasured} not measured</span>}
          <span data-edge-summary>edge not checked</span>
        </p>
      </div>
      <dl class="mono when">
        <div><dt>build</dt><dd>{s.sha}</dd></div>
        <div><dt>computed</dt><dd><time datetime={s.generatedAt}>{stamp(s.generatedAt)}</time></dd></div>
      </dl>
    </section>

    <section aria-labelledby="components-title">
      <div class="block-head">
        <h2 id="components-title">Components</h2>
        <p class="mono legend" aria-hidden="true">
          <span><i class="dot"></i>operational</span>
          <span><i class="dot" data-tone="amber"></i>degraded</span>
          <span><i class="dot" data-tone="red"></i>down</span>
          <span><i class="dot" data-tone="muted"></i>not measured</span>
        </p>
      </div>
      <div class="panel">
        {
          groups.map((g) => (
            <div class="group">
              <h3 class="group-title mono">
                {g.title} <span>· {g.note}</span>
              </h3>
              <ul class="rows" role="list">
                {s.components
                  .filter((c) => c.group === g.id)
                  .map((c) => (
                    <li class="row" data-component={c.id} data-probe={c.probe}>
                      <p class="name">{c.href ? <a href={c.href}>{c.name}</a> : c.name}</p>
                      <p class="evidence">
                        {c.evidence}
                        {c.probe && (
                          <span class="check mono" data-check>
                            Live check: GET {c.probe}, not run yet.
                          </span>
                        )}
                      </p>
                      <p class="metric mono tabular">{c.metric}</p>
                      <p class="state" data-state={c.probe ? 'pending' : c.status}>
                        <span class="dot" data-tone={STATE_TONE[c.status]} data-dot />
                        <span data-label>{c.probe ? 'Not checked' : STATE_LABEL[c.status]}</span>
                      </p>
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="history-title">
      <div class="block-head">
        <h2 id="history-title">Deploy history</h2>
        <p class="mono meta">
          {s.history.length} of 90 slots recorded · {passing}/{s.history.length} passing gates
        </p>
      </div>
      <div class="panel strip-panel">
        <div class="strip-top">
          <p class="strip-name">
            Retrieval gates per build <span class="mono">hit@3 ≥ {pct(HIT3_MIN)} · refusal ≥ {pct(REFUSAL_MIN)}</span>
          </p>
          <p class="mono legend" aria-hidden="true">
            <span><i class="sw" data-state="ok"></i>passing</span>
            <span><i class="sw" data-state="degraded"></i>degraded</span>
            <span><i class="sw" data-state="none"></i>no data</span>
          </p>
        </div>
        {
          strips.map((st) => (
            <div class:list={['strip', st.cls]}>
              <svg
                class="bars"
                data-bars
                viewBox={`0 0 ${st.n * (W + GAP) - GAP} ${H}`}
                preserveAspectRatio="none"
                role="group"
                aria-label={`Deploy history, last ${st.n} slots: ${s.history.slice(-st.n).length} recorded builds, ${s.history.slice(-st.n).filter((e) => entryState(e) === 'ok').length} passing. Full table below.`}
              >
                {st.list.map((sl, i) =>
                  sl.entry ? (
                    <rect
                      x={i * (W + GAP)}
                      y="0"
                      width={W}
                      height={H}
                      rx="1.5"
                      data-state={sl.state}
                      data-current={sl.current ? '' : undefined}
                      data-detail={label(sl)}
                      tabindex="0"
                      role="img"
                      aria-label={label(sl)}
                    >
                      <title>{label(sl)}</title>
                    </rect>
                  ) : (
                    <rect x={i * (W + GAP)} y="0" width={W} height={H} rx="1.5" data-state="none" aria-hidden="true">
                      <title>{label(sl)}</title>
                    </rect>
                  ),
                )}
              </svg>
              <div class="axis mono" aria-hidden="true">
                <span>{st.n} builds ago</span>
                <i />
                <span>{okShare} passing</span>
                <i />
                <span>Latest</span>
              </div>
            </div>
          ))
        }
        <p class="readout mono" data-readout>
          <span class="tag">latest</span><span data-readout-text>{latest ? label({ state: entryState(latest), entry: latest, current: latest.sha === s.sha }) : 'No builds recorded'}</span>
        </p>
        <details class="table-details">
          <summary>Show history as a table</summary>
          <div class="table-wrap">
            <table>
              <caption class="sr-only">Recorded builds, newest first</caption>
              <thead>
                <tr>
                  <th scope="col">Build</th><th scope="col">Date (UTC)</th><th scope="col" class="num">hit@1</th><th scope="col" class="num">hit@3</th>
                  <th scope="col" class="num">MRR</th><th scope="col" class="num">Refusal</th><th scope="col" class="num">Chunks</th><th scope="col">State</th>
                </tr>
              </thead>
              <tbody>
                {[...s.history].reverse().map((e) => (
                  <tr>
                    <th scope="row" class="mono">{e.sha}{e.sha === s.sha && <span class="this"> this build</span>}</th>
                    <td class="mono">{stamp(e.date).replace(' UTC', '')}</td>
                    <td class="num mono">{pct(e.hit1)}</td>
                    <td class="num mono">{pct(e.hit3)}</td>
                    <td class="num mono">{e.mrr.toFixed(3)}</td>
                    <td class="num mono">{pct(e.refusal)}</td>
                    <td class="num mono">{e.chunks}</td>
                    <td><span class="chip" data-tone={entryState(e) === 'ok' ? 'signal' : 'amber'}>{entryState(e) === 'ok' ? 'passing' : 'degraded'}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </div>
    </section>

    <section aria-labelledby="incidents-title">
      <div class="block-head">
        <h2 id="incidents-title">Incidents</h2>
        <p class="mono meta">declared by hand, with a postmortem</p>
      </div>
      <div class="panel incidents">
        <p class="none"><span class="dot" data-tone="muted"></span>No incidents recorded.</p>
        <p class="note">
          Degraded states above are measurements, not declarations. An incident is only listed here once it has been written up as a
          postmortem, and none has been filed yet.
        </p>
      </div>
    </section>

    <section class="how" aria-labelledby="how-title">
      <h2 id="how-title" class="eyebrow">How this page works</h2>
      <ul>
        <li>
          <strong>Build</strong> components are computed by <code>src/lib/status.ts</code> while the site builds. Retrieval reuses the golden-set run
          behind <a class="link" href="/evals/">/evals</a> and is degraded below hit@3 {pct(HIT3_MIN)} or refusal {pct(REFUSAL_MIN)}. Counts come from
          the content collections, and the résumé check looks for the PDF on disk.
        </li>
        <li>
          <strong>Edge</strong> components run on a Cloudflare Worker, so a static build can't know their state. Your browser calls
          <code>/api/health</code> with a 4-second timeout. Anything other than a healthy response shows <em>static mode</em>, where contact falls back to
          email and Ask runs in the browser.
        </li>
        <li>
          <strong>Quality gates</strong> read <code>test-results/summary.json</code> from the QA suite when it exists. Without it, the row says not
          measured instead of guessing.
        </li>
        <li>
          After each deploy build, CI runs <code>npm run status:record</code>, which appends <code>{'{sha, date, hit1, hit3, mrr, refusal, chunks}'}</code> to{' '}
          <a class="link" href="/status-history.json">/status-history.json</a> (90 entries, one per commit). Empty slots mean no deploy was recorded, not downtime.
        </li>
        <li>
          Source and method: <a class="link" href={repo}>GitHub repo</a> · <a class="link" href={`${repo}/blob/main/docs/STATUS.md`}>docs/STATUS.md</a>.
        </li>
      </ul>
    </section>
  </div>

  <script type="application/json" data-status-snapshot set:html={JSON.stringify(s.current).replace(/</g, '\\u003c')} />
</BaseLayout>

<script>
  const TIMEOUT_MS = 4000;
  const page = document.querySelector<HTMLElement>('[data-status-page]');

  type Health = { ok: boolean; ms: number; corpus?: string | null; model?: string; why?: string };

  async function probe(url: string): Promise<Health> {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), TIMEOUT_MS);
    const t0 = performance.now();
    try {
      const r = await fetch(url, { cache: 'no-store', headers: { accept: 'application/json' }, signal: ctrl.signal });
      const ms = Math.round(performance.now() - t0);
      if (!r.ok) return { ok: false, ms, why: `HTTP ${r.status}` };
      const body = await r.json().catch(() => null);
      if (body?.status !== 'ok') return { ok: false, ms, why: 'unexpected response' };
      return { ok: true, ms, corpus: body.corpusVersion, model: body.model };
    } catch (e) {
      return { ok: false, ms: Math.round(performance.now() - t0), why: (e as Error).name === 'AbortError' ? `no answer in ${TIMEOUT_MS / 1000}s` : 'unreachable' };
    } finally {
      clearTimeout(timer);
    }
  }

  function setState(row: HTMLElement, state: string, tone: string, text: string, check: string) {
    const st = row.querySelector<HTMLElement>('.state');
    if (st) st.dataset.state = state;
    const dot = row.querySelector<HTMLElement>('[data-dot]');
    if (dot) dot.dataset.tone = tone;
    const label = row.querySelector('[data-label]');
    if (label) label.textContent = text;
    const c = row.querySelector('[data-check]');
    if (c) c.textContent = check;
  }

  async function checkEdge() {
    const rows = [...document.querySelectorAll<HTMLElement>('[data-probe]')];
    const summary = document.querySelector('[data-edge-summary]');
    if (!rows.length) return;
    for (const r of rows) setState(r, 'pending', 'azure', 'Checking…', `Live check: GET ${r.dataset.probe} in progress…`);
    if (summary) summary.textContent = 'edge checking…';

    const urls = [...new Set(rows.map((r) => r.dataset.probe!))];
    const results = new Map(await Promise.all(urls.map(async (u) => [u, await probe(u)] as const)));
    const build = page?.dataset.corpusVersion;
    const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    let ok = 0;
    for (const r of rows) {
      const h = results.get(r.dataset.probe!)!;
      if (h.ok) {
        ok++;
        const drift = h.corpus && build && h.corpus !== build ? ` · corpus ${h.corpus} differs from this build` : h.corpus ? ` · corpus ${h.corpus}` : '';
        setState(r, 'operational', 'signal', 'Operational', `Live check at ${time}: GET ${r.dataset.probe} ok in ${h.ms} ms${drift}.`);
      } else {
        setState(r, 'static', 'amber', 'Static mode', `Live check at ${time}: GET ${r.dataset.probe} ${h.why}. Fallback active.`);
      }
    }
    if (summary) summary.textContent = ok === rows.length ? 'edge operational' : ok ? 'edge partially in static mode' : 'edge in static mode (fallback active)';
    // A fallback is a degraded mode, so it downgrades an otherwise operational headline (never upgrades one).
    const banner = document.querySelector<HTMLElement>('.banner');
    if (ok < rows.length && banner?.dataset.state === 'operational') {
      banner.dataset.state = 'degraded';
      const dot = banner.querySelector<HTMLElement>('[data-overall-dot]');
      if (dot) dot.dataset.tone = 'amber';
      const h = banner.querySelector('[data-overall-headline]');
      if (h) h.textContent = 'Partial degradation';
    }
  }

  function wireBars() {
    const out = document.querySelector('[data-readout-text]');
    const tag = document.querySelector('[data-readout] .tag');
    if (!out || !tag) return;
    const initial = out.textContent;
    let active: Element | null = null;
    const show = (rect: Element | null) => {
      active?.removeAttribute('data-active');
      active = rect;
      if (rect) {
        rect.setAttribute('data-active', '');
        out.textContent = rect.getAttribute('data-detail');
        tag.textContent = 'selected';
      } else {
        out.textContent = initial;
        tag.textContent = 'latest';
      }
    };
    for (const svg of document.querySelectorAll('svg[data-bars]')) {
      const pick = (e: Event) => show((e.target as Element).closest?.('rect[data-detail]') ?? null);
      svg.addEventListener('pointerover', pick);
      svg.addEventListener('focusin', pick);
      svg.addEventListener('pointerleave', () => show(null));
      svg.addEventListener('focusout', () => show(null));
    }
  }

  wireBars();
  checkEdge();
</script>

<style>
  .page-head {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  h1 {
    margin-top: 1rem;
    font-size: var(--step-5);
    letter-spacing: -0.05em;
    line-height: 0.95;
  }
  h1 em {
    font-style: italic;
    color: var(--fg-muted);
    letter-spacing: -0.02em;
  }
  .lede {
    margin-top: 1.25rem;
  }
  .stack {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  /* State colours. .dot/.chip tones come from global.css; red has no global tone yet. */
  .dot[data-tone='red'] {
    --c: var(--red);
  }
  .dot[data-tone='signal'] {
    --c: var(--signal);
  }
  [data-state='operational'],
  [data-state='ok'] {
    --tone: var(--signal);
  }
  [data-state='degraded'],
  [data-state='static'] {
    --tone: var(--amber);
  }
  [data-state='down'] {
    --tone: var(--red);
  }
  [data-state='not-configured'] {
    --tone: var(--fg-faint);
  }
  [data-state='pending'] {
    --tone: var(--fg-muted);
  }

  /* Overall banner */
  .banner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem 1.25rem;
    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius);
    border: 1px solid color-mix(in oklch, var(--tone) 42%, transparent);
    background:
      linear-gradient(90deg, color-mix(in oklch, var(--tone) 14%, transparent), transparent 70%),
      var(--bg-raised);
    box-shadow: var(--shadow);
  }
  .dot.big {
    width: 14px;
    height: 14px;
    box-shadow: 0 0 0 5px color-mix(in oklch, var(--c) 22%, transparent);
  }
  .banner h2 {
    font-size: var(--step-2);
    letter-spacing: -0.035em;
  }
  .summary {
    margin-top: 0.45rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    font-size: 0.78rem;
    color: var(--fg-muted);
  }
  .summary span + span::before {
    content: '·';
    margin-inline: 0.55rem;
    color: var(--fg-faint);
  }
  .when {
    display: grid;
    gap: 0.2rem;
    font-size: 0.72rem;
    text-align: right;
  }
  .when div {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
  }
  .when dt {
    color: var(--fg-faint);
  }
  .when dd {
    color: var(--fg-muted);
  }

  /* Section heads */
  .block-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1rem;
  }
  .block-head h2 {
    font-size: var(--step-1);
    letter-spacing: -0.02em;
  }
  .meta {
    font-size: 0.75rem;
    color: var(--fg-faint);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: 0.72rem;
    color: var(--fg-faint);
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .legend .dot {
    width: 7px;
    height: 7px;
    box-shadow: none;
  }

  .panel {
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  /* Component rows */
  .group + .group {
    border-top: 1px solid var(--line-soft);
  }
  .group-title {
    padding: 0.7rem clamp(1rem, 2.5vw, 1.5rem);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    background: var(--bg-sunken);
    border-bottom: 1px solid var(--line-soft);
  }
  .group-title span {
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.01em;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(7rem, auto) 9.5rem;
    grid-template-areas:
      'name metric state'
      'evidence metric state';
    align-items: center;
    column-gap: clamp(1rem, 3vw, 2.5rem);
    row-gap: 0.25rem;
    padding: 1rem clamp(1rem, 2.5vw, 1.5rem);
    transition: background var(--t-2) var(--ease-out);
  }
  .row + .row {
    border-top: 1px solid var(--line-soft);
  }
  .row:hover {
    background: color-mix(in oklch, var(--bg-sunken) 55%, transparent);
  }
  .name {
    grid-area: name;
    font-weight: 560;
    letter-spacing: -0.01em;
    align-self: end;
  }
  .name a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--t-2);
  }
  .name a:hover {
    text-decoration-color: var(--signal);
  }
  .evidence {
    grid-area: evidence;
    align-self: start;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .check {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.72rem;
    color: var(--fg-faint);
  }
  .metric {
    grid-area: metric;
    justify-self: end;
    font-size: 0.85rem;
    color: var(--fg);
    white-space: nowrap;
  }
  .state {
    grid-area: state;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.85rem;
    font-weight: 550;
    color: var(--tone);
    white-space: nowrap;
  }
  .state[data-state='not-configured'],
  .state[data-state='pending'] {
    font-weight: 450;
  }

  /* Deploy strip */
  .strip-panel {
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
    display: grid;
    gap: 1rem;
  }
  .strip-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }
  .strip-name {
    font-weight: 560;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }
  .strip-name span {
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--fg-faint);
  }
  .sw {
    display: inline-block;
    width: 6px;
    height: 12px;
    border-radius: 1.5px;
    background: var(--tone, var(--line));
  }
  .sw[data-state='none'],
  .bars rect[data-state='none'] {
    --tone: color-mix(in oklch, var(--fg-faint) 32%, var(--bg-raised));
  }
  .strip.narrow {
    display: none;
  }
  .bars {
    display: block;
    width: 100%;
    height: 2.5rem;
    overflow: visible;
  }
  .bars rect {
    fill: var(--tone);
    transition:
      opacity var(--t-2) var(--ease-out),
      fill var(--t-2) var(--ease-out);
  }
  .bars rect[data-detail] {
    cursor: pointer;
  }
  .bars:has(rect[data-active]) rect:not([data-active]) {
    opacity: 0.55;
  }
  .bars rect:focus {
    outline: none;
  }
  .bars rect:focus-visible,
  .bars rect[data-current] {
