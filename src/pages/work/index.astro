---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkList from '../../components/WorkList.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Work"
  description="Client case studies: Azure and AWS landing zones, Kubernetes platforms, GitLab and Harness delivery, DR and AI evaluation work, written as postmortems with real numbers."
>
  <section class="container-x page-head">
    <p class="eyebrow">Work · {work.length} case studies</p>
    <h1>Engagements, <em class="serif">written as postmortems.</em></h1>
    <p class="lede">
      Context, constraints, the decisions that mattered and what actually changed. Client names are real; the numbers come from the work
      itself: banking, retail, telecom, government, construction SaaS and AI evaluation, on Azure, AWS, GCP and on-prem.
    </p>
  </section>
  <section class="container-x" aria-labelledby="list-title">
    <h2 id="list-title" class="visually-hidden">All case studies</h2>
    <WorkList items={work} />
  </section>
  <ContactCTA />
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .page-head {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2rem, 4vw, 3rem);
  }
  h1 {
    margin-top: 1rem;
    font-size: var(--step-5);
    letter-spacing: -0.05em;
    line-height: 0.95;
    max-width: 16ch;
  }
  h1 em {
    font-style: normal;
    color: var(--fg-muted);
    letter-spacing: -0.02em;
  }
  .lede {
    margin-top: 1.5rem;
  }
</style>
