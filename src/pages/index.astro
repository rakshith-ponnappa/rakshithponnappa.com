---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WorkList from '../components/WorkList.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import CareerTrace from '../components/CareerTrace.astro';
import FieldMap from '../components/FieldMap.astro';
import CertWall from '../components/CertWall.astro';
import AskPanel from '../components/AskPanel.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Icon from '../components/Icon.astro';
import { highlights, profile } from '../data/profile';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featured = work.filter((w) => w.data.featured).slice(0, 5);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const jsonLd = [
  {
    '@type': 'ProfilePage',
    '@id': `${Astro.site}#profile`,
    url: Astro.site?.toString(),
    name: `${profile.name}: ${profile.headline}`,
    mainEntity: { '@id': `${Astro.site}#person` },
  },
];
---

<BaseLayout jsonLd={jsonLd} type="profile">
  <Hero />

  <section class="slis container-x" aria-label="At a glance">
    <ul>
      {
        highlights.map((h, i) => (
          <li class="reveal">
            <span class="k mono">sli_{String(i + 1).padStart(2, '0')}</span>
            <span class="v tabular">{h.value}</span>
            <span class="l">{h.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container-x" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title" class="section-title">Platforms in production, <em>and what it took to get them there.</em></h2>
      <p class="lede">
        Client engagements across banking, retail, telecom and government. Each one is written up as context, constraints, decisions and
        outcomes, with the real numbers.
      </p>
    </div>
    <WorkList items={featured} />
    <a class="more link" href="/work/">All {work.length} case studies <Icon name="arrow-right" size={16} /></a>
  </section>

  <section class="section container-x" aria-labelledby="proj-title">
    <div class="section-head">
      <h2 id="proj-title" class="section-title">Things I’ve built <em>in the open.</em></h2>
      <p class="lede">
        AI systems, platform templates and tools, each with tests, CI and an honest list of limitations. Every repo is public on GitHub.
      </p>
    </div>
    <ProjectGrid items={projects.slice(0, 6)} filter={false} id="home-catalog" />
    <a class="more link" href="/projects/">All {projects.length} projects <Icon name="arrow-right" size={16} /></a>
  </section>

  <section class="section container-x" aria-labelledby="trace-title">
    <div class="section-head">
      <h2 id="trace-title" class="section-title">Twelve years, <em>one long-running trace.</em></h2>
      <p class="lede">Each span is a role, rendered like a distributed trace. Open the full trace for the detail behind each one.</p>
    </div>
    <CareerTrace compact />
    <a class="more link" href="/experience/">Open the full trace <Icon name="arrow-right" size={16} /></a>
  </section>

  <section class="section container-x" aria-labelledby="field-title">
    <div class="section-head">
      <h2 id="field-title" class="section-title">Four years on the ground <em>in the Gulf.</em></h2>
      <p class="lede">
        On-site in Dubai and Muscat for telecom, banking, government and energy clients: the kind of delivery where the platform has
        to work on day one.
      </p>
    </div>
    <FieldMap />
  </section>

  <section class="section container-x" aria-labelledby="ask-title">
    <div class="section-head">
      <h2 id="ask-title" class="section-title">Questions? <em>Ask my public record.</em></h2>
      <p class="lede">
        A small retrieval-augmented assistant grounded only in this site. It cites its sources, refuses what it can’t answer, and
        its <a class="link" href="/evals/">evals are public</a>.
      </p>
    </div>
    <AskPanel />
  </section>

  <section class="section container-x" aria-labelledby="cred-title">
    <div class="section-head">
      <h2 id="cred-title" class="section-title">Certifications <em>across cloud, platform and AI.</em></h2>
    </div>
    <CertWall />
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .slis ul {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    background: var(--bg-raised);
    overflow: hidden;
  }
  .slis li {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    padding: 1.4rem 1.25rem;
    border-right: 1px solid var(--line-soft);
  }
  .slis li:last-child {
    border-right: 0;
  }
  .slis .k {
    font-size: 0.75rem;
    color: var(--fg-faint);
    letter-spacing: 0.04em;
  }
  .slis .v {
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    margin-top: 0.35rem;
  }
  .slis .l {
    font-size: 0.85rem;
    color: var(--fg-muted);
    line-height: 1.35;
  }
  .more {
    margin-top: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 500;
  }
  @media (max-width: 1000px) {
    .slis ul {
      grid-template-columns: repeat(3, 1fr);
    }
    .slis li:nth-child(3) {
      border-right: 0;
    }
    .slis li:nth-child(-n + 3) {
      border-bottom: 1px solid var(--line-soft);
    }
  }
  @media (max-width: 560px) {
    .slis ul {
      grid-template-columns: repeat(2, 1fr);
    }
    .slis li {
      border-right: 1px solid var(--line-soft) !important;
      border-bottom: 1px solid var(--line-soft);
    }
    .slis li:nth-child(2n) {
      border-right: 0 !important;
    }
  }
</style>
