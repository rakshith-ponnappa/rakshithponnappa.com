---
import BaseLayout from '../layouts/BaseLayout.astro';
import CertWall from '../components/CertWall.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { certifications, profile } from '../data/profile';
const issuers = new Set(certifications.map((c) => c.issuer)).size;
---

<BaseLayout
  title="Credentials"
  description={`${certifications.length} certifications from ${issuers} issuers (AWS Professional x2, AZ-400, CKA, Terraform, Agentic AI AB-100) plus an IIT Madras course in IoT, Cloud & Blockchain.`}
>
  <section class="container-x page-head">
    <h1>Certified, <em class="serif">then proven in production.</em></h1>
    <p class="subhead">{certifications.length} certifications · {issuers} issuers</p>
    <p class="lede">
      From AWS Professional and Azure DevOps Expert to CKA, Terraform and Microsoft’s Agentic AI architect exam. Certificates can be
      verified on <a class="link" href={profile.linkedin} rel="noopener">LinkedIn</a>.
    </p>
  </section>
  <section class="container-x wall-wrap">
    <CertWall full />
  </section>
  <ContactCTA />
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2rem, 4vw, 3rem);
  }
  h1 {
    margin-top: 1rem;
    font-size: var(--step-5);
    letter-spacing: -0.05em;
    line-height: 0.95;
    max-width: 15ch;
  }
  h1 em {
    font-style: normal;
    color: var(--fg-muted);
    letter-spacing: -0.02em;
  }
  .lede {
    margin-top: 1.5rem;
  }
  .wall-wrap {
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
</style>
