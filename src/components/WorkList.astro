---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  items: CollectionEntry<'work'>[];
}
const { items } = Astro.props;
---

<ol class="work-list">
  {
    items.map((w, i) => (
      <li class="reveal">
        <a href={`/work/${w.id}/`} class="row glow">
          <span class="idx mono">{String(i + 1).padStart(2, '0')}</span>
          <div class="main">
            <p class="client mono">
              {w.data.client} <span class="sep">·</span> {w.data.industry}
            </p>
            <h3 data-vt={`work-${w.id}`}>{w.data.title}</h3>
            <p class="summary">{w.data.summary}</p>
            <div class="chips">
              {w.data.clouds.map((c) => (
                <span class="chip" data-tone="azure">
                  {c}
                </span>
              ))}
              {w.data.stack.slice(0, 4).map((s) => (
                <span class="chip">{s}</span>
              ))}
            </div>
          </div>
          <dl class="metrics">
            {w.data.metrics.slice(0, 2).map((m) => (
              <div>
                <dt class="mono tabular">{m.value}</dt>
                <dd>{m.label}</dd>
              </div>
            ))}
          </dl>
          <span class="go" aria-hidden="true">
            <Icon name="arrow-up-right" size={20} />
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .work-list {
    display: grid;
    border-top: 1px solid var(--line-soft);
  }
  .work-list li {
    border-bottom: 1px solid var(--line-soft);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 15rem) 2rem;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: clamp(1.5rem, 3vw, 2.25rem) clamp(0.5rem, 1.5vw, 1.25rem);
    border-radius: var(--radius);
    transition: background var(--t-3) var(--ease-out);
  }
  .row:hover {
    background: color-mix(in oklch, var(--bg-raised) 85%, transparent);
  }
  .idx {
    font-size: 0.8rem;
    color: var(--fg-faint);
    padding-top: 0.3rem;
  }
  .client {
    font-size: 0.75rem;
    color: var(--signal);
    letter-spacing: 0.02em;
  }
  .sep {
    color: var(--fg-faint);
  }
  h3 {
    margin-top: 0.5rem;
    font-size: var(--step-2);
    transition: color var(--t-2);
  }
  .summary {
    margin-top: 0.75rem;
    color: var(--fg-muted);
    max-width: 52ch;
    font-size: 0.98rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .chips {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chips :global(.chip) {
    max-width: 100%;
    white-space: normal;
    line-height: 1.3;
  }
  .metrics {
    display: grid;
    align-content: start;
    gap: 1.1rem;
    padding-top: 0.2rem;
  }
  .metrics dt {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    color: var(--fg);
    line-height: 1;
  }
  .metrics dd {
    margin-top: 0.35rem;
    font-size: 0.82rem;
    color: var(--fg-faint);
    line-height: 1.35;
  }
  .go {
    color: var(--fg-faint);
    padding-top: 0.2rem;
    transition:
      transform var(--t-3) var(--ease-out),
      color var(--t-2);
  }
  .row:hover .go {
    color: var(--signal);
    transform: translate(3px, -3px);
  }
  @media (max-width: 860px) {
    .row {
      grid-template-columns: 2.25rem minmax(0, 1fr);
    }
    .metrics {
      grid-column: 2;
      grid-template-columns: 1fr 1fr;
    }
    .go {
      display: none;
    }
  }
</style>
