---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---

<section class="cta container-x" aria-labelledby="cta-title">
  <div class="inner card">
    <h2 id="cta-title">
      Have a platform to build or an AI system to ship? <em class="serif">Let’s talk.</em>
    </h2>
    <p class="lede">{profile.openTo}.</p>
    <div class="row">
      <a class="btn btn-primary" href="/contact/">Open a ticket <Icon name="arrow-right" /></a>
      <button class="btn" type="button" data-copy={profile.email}>
        <Icon name="mail" />
        {profile.email}
        <Icon name="copy" size={14} />
      </button>
      <a class="btn btn-ghost" href={profile.phoneHref}><Icon name="phone" /> {profile.phone}</a>
    </div>
  </div>
</section>

<style>
  .inner {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 6vw, 4.5rem);
    background: var(--bg-raised);
  }
  h2 {
    margin-top: 1rem;
    font-size: var(--step-4);
    letter-spacing: -0.04em;
    max-width: 18ch;
  }
  h2 em {
    font-style: normal;
    color: var(--signal);
    letter-spacing: -0.01em;
  }
  .lede {
    margin-top: 1.25rem;
  }
  .row {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  @media (max-width: 400px) {
    .row .btn {
      white-space: normal;
      overflow-wrap: anywhere;
      height: auto;
      min-height: 2.75rem;
      padding-block: 0.5rem;
    }
  }
  [data-copied] {
    border-color: var(--signal);
  }
</style>
