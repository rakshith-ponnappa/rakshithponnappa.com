---
import Icon from './Icon.astro';
import { nav, isActive } from '../lib/site';
import { profile } from '../data/profile';
const path = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="container-x bar">
    <a href="/" class="brand" aria-label={`${profile.name}, home`}>
      <svg class="mark" viewBox="0 0 28 28" aria-hidden="true">
        <path d="M7 20 14 8l7 12" fill="none" stroke="currentColor" stroke-width="1.4" opacity=".55"></path>
        <path d="M7 20h14" fill="none" stroke="currentColor" stroke-width="1.4" opacity=".3"></path>
        <circle cx="14" cy="8" r="3" class="mark-core"></circle>
        <circle cx="7" cy="20" r="2.4" fill="currentColor"></circle>
        <circle cx="21" cy="20" r="2.4" fill="currentColor"></circle>
      </svg>
      <span class="brand-name">{profile.name}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {
        nav.map((n) => (
          <a href={n.href} aria-current={isActive(path, n.href) ? 'page' : undefined}>
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <button class="cmdk-trigger" type="button" data-cmdk-open>
        <Icon name="search" size={15} />
        <span class="cmdk-hint">Search or ask</span>
        <kbd data-mod aria-hidden="true">⌘K</kbd>
      </button>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle colour theme">
        <Icon name="sun" class="i-sun" />
        <Icon name="moon" class="i-moon" />
      </button>
      <button class="icon-btn menu-btn" type="button" popovertarget="mobile-nav" aria-label="Open menu">
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" popover aria-label="Mobile">
    <div class="mobile-head">
      <span class="eyebrow">Navigate</span>
      <button class="icon-btn" type="button" popovertarget="mobile-nav" popovertargetaction="hide" aria-label="Close menu">
        <Icon name="x" />
      </button>
    </div>
    <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
    {nav.map((n) => <a href={n.href} aria-current={isActive(path, n.href) ? 'page' : undefined}>{n.label}</a>)}
    <a href="/credentials/" aria-current={isActive(path, '/credentials/') ? 'page' : undefined}>Credentials</a>
    <a href="/contact/" aria-current={isActive(path, '/contact/') ? 'page' : undefined}>Contact</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: var(--bg-glass);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-3) var(--ease-out);
    view-transition-name: site-header;
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--line-soft);
  }
  @supports (animation-timeline: scroll()) {
    .site-header {
      animation: header-line linear both;
      animation-timeline: scroll(root);
      animation-range: 0 80px;
    }
    @keyframes header-line {
      to {
        border-bottom-color: var(--line-soft);
      }
    }
  }
  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin-right: auto;
  }
  .mark {
    width: 28px;
    height: 28px;
    color: var(--fg-muted);
  }
  .mark-core {
    fill: var(--signal);
  }
  .brand:hover .mark-core {
    fill: var(--amber);
  }
  .nav {
    display: flex;
    gap: 0.25rem;
  }
  .nav a {
    position: relative;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    font-size: 0.92rem;
    color: var(--fg-muted);
    transition:
      color var(--t-2),
      background var(--t-2);
  }
  .nav a:hover {
    color: var(--fg);
    background: color-mix(in oklch, var(--fg) 6%, transparent);
  }
  .nav a[aria-current='page'] {
    color: var(--fg);
  }
  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--signal);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cmdk-trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    padding: 0 0.5rem 0 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line-soft);
    background: color-mix(in oklch, var(--bg-sunken) 60%, transparent);
    color: var(--fg-faint);
    font-size: 0.85rem;
    cursor: pointer;
    transition: border-color var(--t-2);
  }
  .cmdk-trigger:hover {
    border-color: var(--line);
    color: var(--fg-muted);
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid var(--line-soft);
    color: var(--fg-muted);
    background: transparent;
    cursor: pointer;
    transition:
      color var(--t-2),
      border-color var(--t-2);
  }
  .icon-btn:hover {
    color: var(--fg);
    border-color: var(--line);
  }
  :global(:root[data-theme='light']) .icon-btn :global(.i-sun),
  :global(:root:not([data-theme='light'])) .icon-btn :global(.i-moon) {
    display: none;
  }
  .menu-btn {
    display: none;
  }
  .mobile-nav {
    inset: 0 0 auto auto;
    margin: 0.75rem;
    width: min(20rem, calc(100vw - 1.5rem));
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--fg);
    box-shadow: var(--shadow);
  }
  .mobile-nav:popover-open {
    display: grid;
    gap: 0.15rem;
  }
  .mobile-nav::backdrop {
    background: oklch(0 0 0 / 0.4);
    backdrop-filter: blur(4px);
  }
  .mobile-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .mobile-nav a {
    padding: 0.7rem 0.5rem;
    border-radius: 8px;
    font-size: 1.05rem;
  }
  .mobile-nav a:hover {
    background: var(--bg-sunken);
  }
  .mobile-nav a[aria-current='page'] {
    background: var(--bg-sunken);
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .nav {
      display: none;
    }
    .cmdk-hint {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .menu-btn {
      display: grid;
    }
    .cmdk-trigger {
      padding: 0 0.6rem;
    }
  }
  @media (max-width: 420px) {
    .brand-name {
      display: none;
    }
  }
</style>
