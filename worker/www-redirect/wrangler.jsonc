{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rakshithponnappa-www",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  // Every alias host 301s to the canonical https://rakshithponnappa.dev (see index.ts).
  "routes": [
    { "pattern": "www.rakshithponnappa.dev", "custom_domain": true },
    { "pattern": "rakshithponnappa.com", "custom_domain": true },
    { "pattern": "www.rakshithponnappa.com", "custom_domain": true }
  ]
}
